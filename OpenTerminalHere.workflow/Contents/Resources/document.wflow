				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/zsh
setopt NULL_GLOB   # 没有匹配的 kitty socket 时不要报错

# 解析目标目录:优先参数,否则读最前 Finder 窗口,再不行用主目录。
dir=""
for a in "$@"; do
    if [ -d "$a" ]; then dir="$a"; break; fi
done

if [ -z "$dir" ]; then
    dir="$(/usr/bin/osascript &lt;&lt;'OSA'
tell application "Finder"
    try
        set t to target of front window as alias
        return POSIX path of t
    on error
        return POSIX path of (path to home folder)
    end try
end tell
OSA
)"
fi
[ -d "$dir" ] || dir="$HOME"

KITTY=/opt/homebrew/bin/kitty

# 找一个开启了远程控制的 kitty 实例(取 PID 最小的作为"主窗口")。
sock=""
best_pid=""
for s in "$HOME"/.cache/kitty-remote-*; do
    [ -S "$s" ] || continue
    pid="${s##*-}"
    if [ -z "$best_pid" ] || [ "$pid" -lt "$best_pid" ]; then
        sock="$s"; best_pid="$pid"
    fi
done

# 有 kitty → 在它里面新开一个 tab。
if [ -n "$sock" ]; then
    if "$KITTY" @ --to "unix:$sock" launch --type=tab --cwd="$dir" --tab-title="$(/usr/bin/basename "$dir")" &gt;/dev/null 2&gt;&amp;1; then
        exit 0
    fi
fi

# 还没有可用的 kitty → 新开一个窗口(新窗口会按配置创建 socket)。
/usr/bin/open -na /Applications/kitty.app --args --directory="$dir"
</string>
